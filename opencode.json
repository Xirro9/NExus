{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "shadcn": {
        "type": "local",
        "command": ["npx", "shadcn@latest", "mcp"]
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@latest"]
      },
      "context7": {
        "type": "local",
        "command": ["npx", "-y", "@upstash/context7-mcp"]
      }
    }
  }
}
